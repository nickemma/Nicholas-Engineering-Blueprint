---
import Base from "../../layouts/Base.astro";
import { LABS } from "../../lib/labs.ts";
---
<Base title="Labs" description="Interactive labs for DevOps, platform, SRE, backend, systems, security, MLOps, AIOps and AI security.">
  <section class="band first">
    <h1>Labs</h1>
    <p class="lede">Each lab runs in your browser: most are small simulations, and one replays recorded attacks on a real model. Each shows one idea from the route, tells you what it leaves out, and links to the guide where you build the real thing.</p>
    <ul class="cards two">
      {LABS.map((lab) => (
        <li><a href={lab.url}><small>{lab.area}</small><h3>{lab.title}</h3><p>{lab.blurb}</p></a></li>
      ))}
    </ul>
  </section>
</Base>
