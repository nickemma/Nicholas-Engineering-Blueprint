+++ broken/race/wordcount/race_test.go	2026-11-18 22:29:23.075693464 -0800
@@ -0,0 +1,22 @@
+package wordcount
+
+import (
+	"sync"
+	"testing"
+)
+
+func TestCountConcurrently(t *testing.T) {
+	total := 0
+	var wg sync.WaitGroup
+	for range 4 {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			total += Count("a b c")["a"]
+		}()
+	}
+	wg.Wait()
+	if total == 0 {
+		t.Fatal("nothing counted")
+	}
+}
